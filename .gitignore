cat > .gitignore <<'EOF'
# Python
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Python tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# macOS
.DS_Store

# IDE / editors
.vscode/
.idea/

# Logs
*.log

# Temporary files
*.tmp
*.temp
*.swp
*~
EOF
